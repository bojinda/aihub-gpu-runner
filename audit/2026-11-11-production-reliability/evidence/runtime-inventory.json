    "meeting-postprocess.service": "# /etc/systemd/system/meeting-postprocess.service\n[Unit]\nDescription=Run WhisperX on latest meeting recording\n\n[Service]\nType=oneshot\nUser=bojinda\nWorkingDirectory=/home/AIHUB_USER/meeting-pipeline\nExecStart=/bin/bash -lc 'LATEST=\"$(cat /home/AIHUB_USER/meeting-pipeline/meeting-recordings/last_recording.txt)\" && /home/AIHUB_USER/meeting-pipeline/bin/postprocess-meeting.sh \"$LATEST\"'\n",
    "postprocess-latest-lesson.service": "# /etc/systemd/system/postprocess-latest-lesson.service\n[Unit]\nDescription=Run WhisperX on latest lesson recording\n\n[Service]\nType=oneshot\nUser=bojinda\nWorkingDirectory=/home/AIHUB_USER/meeting-pipeline\nExecStart=/bin/bash -lc 'LATEST=\"$(cat /home/AIHUB_USER/meeting-pipeline/lesson-recordings/last_recording.txt)\" && /home/AIHUB_USER/meeting-pipeline/bin/postprocess-lesson.sh \"$LATEST\"'\nTimeoutStartSec=infinity\n",
    "runner": "# /etc/systemd/system/aihub-gpu-runner.service\n[Unit]\nDescription=AI-HUB Shared GPU Runner\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=simple\nUser=bojinda\nGroup=bojinda\nWorkingDirectory=/home/AIHUB_USER/aihub-gpu-runner\nEnvironmentFile=/home/AIHUB_USER/.config/aihub-gpu-runner/runner.env\nExecStart=/home/AIHUB_USER/venvs/aihub-gpu-runner/bin/aihub-gpu-runner --config /home/AIHUB_USER/.config/aihub-gpu-runner/config.json serve\nRestart=on-failure\nRestartSec=5\nTimeoutStopSec=30\nUMask=0077\nNoNewPrivileges=true\n\n[Install]\nWantedBy=multi-user.target\n\n# /etc/systemd/system/aihub-gpu-runner.service.d/physical-locks.conf\n# REVIEW ONLY: approved AI-HUB persistent-state mount dependency.\n# Install as a systemd drop-in only during the separately approved migration.\n# Provision 0700 physical-locks directory / 0600 files explicitly; never via startup.\n[Unit]\nRequiresMountsFor=/home/AIHUB_USER/.local/state/aihub-gpu-runner\n\n# /etc/systemd/system/aihub-gpu-runner.service.d/zz-aihub-integrated-recovery.conf\n[Service]\nExecStart=\nExecStart=/opt/aihub-recovery/recovery-integrated-20261109.1/venv/bin/python -I -B -m aihub_gpu_runner --config /home/AIHUB_USER/.config/aihub-gpu-runner/config.json serve\nEnvironment=\"AIHUB_RECOVERY_CONFIG=/etc/aihub/recovery.json\"\nNoNewPrivileges=false\n\n# /etc/systemd/system/aihub-gpu-runner.service.d/zzzz-ollama-probe-compatibility-20261110.1.conf\n[Service]\nExecStart=\nExecStart=/opt/aihub-recovery/ollama-probe-compatibility-20261110.1/venv/bin/python -I -B -m aihub_gpu_runner --config /home/AIHUB_USER/.config/aihub-gpu-runner/config.json serve\n\n# /etc/systemd/system/aihub-gpu-runner.service.d/zzzzz-ha-idle-manual-20261110.1.conf\n[Service]\nExecStart=\nExecStart=/opt/aihub-recovery/ha-idle-manual-20261110.1/venv/bin/python -I -B -m aihub_gpu_runner --config /home/AIHUB_USER/.config/aihub-gpu-runner/config.json serve\n\n# /etc/systemd/system/aihub-gpu-runner.service.d/zzzzzz-ha-recovery-completion-20261110.1.conf\n[Service]\nExecStart=\nExecStart=/opt/aihub-recovery/ha-recovery-completion-20261110.1/venv/bin/python -I -B -m aihub_gpu_runner --config /home/AIHUB_USER/.config/aihub-gpu-runner/config.json serve\n\n# /etc/systemd/system/aihub-gpu-runner.service.d/zzzzzzz-helper-binding-correction-20261110.1.conf\n[Service]\nExecStart=\nExecStart=/opt/aihub-recovery/ha-recovery-completion-20261110.1/venv/bin/python -I -B /opt/aihub-recovery/helper-binding-correction-20261110.1/run_runner.py --config /home/AIHUB_USER/.config/aihub-gpu-runner/config.json serve\n\n# /etc/systemd/system/aihub-gpu-runner.service.d/zzzzzzzz-ollama-recovery-restoration-20261110.1.conf\n[Service]\nExecStart=\nExecStart=/opt/aihub-recovery/ha-recovery-completion-20261110.1/venv/bin/python -I -B /opt/aihub-recovery/ollama-recovery-restoration-20261110.1/run_runner.py --config /home/AIHUB_USER/.config/aihub-gpu-runner/config.json serve\n",
    "watch-lesson-recordings.path": "# /etc/systemd/system/watch-lesson-recordings.path\n[Unit]\nDescription=Watch for new lesson recordings\n\n[Path]\nPathModified=/home/AIHUB_USER/meeting-pipeline/lesson-recordings/last_recording.txt\nUnit=postprocess-latest-lesson.service\n\n[Install]\nWantedBy=multi-user.target\n"
  }
}
